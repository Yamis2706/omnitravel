# URL base del backend OmniTravel (NestJS + Valhalla), sin barra final.
# En un dispositivo físico con Expo Go usa la IP LAN de tu equipo, no "localhost":
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase (autenticación/pasajeros y datos compartidos del equipo)
# Dejar en blanco para usar las credenciales por defecto del proyecto.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

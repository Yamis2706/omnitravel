# OmniTravel — ejemplo de variables de entorno.
# Crea tu archivo local (no versionado) con: cp .env.example .env

# URL base del backend OmniTravel (NestJS + Valhalla), sin barra final.
# En un dispositivo físico con Expo Go usa la IP LAN de tu equipo, no "localhost":
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase — proyecto OmniTravel del equipo (BD gestionada por el equipo de datos).
# 1. Ingresa a https://supabase.com/dashboard → proyecto OmniTravel.
# 2. Project Settings → API Keys → copia la "Publishable key" (clé pública cliente).
# 3. Pega la URL del proyecto y la llave aquí. La secret key jamás va en la app:
#    solo el cliente móvil, nunca se la pidas a un colega para el front.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<···>

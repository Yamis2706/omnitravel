# OmniTravel — ejemplo de variables de entorno.
# Crea tu archivo local (no versionado) con: cp .env.example .env

# URL base del backend OmniTravel (NestJS), sin barra final. Es la única vía
# de la app hacia la base de datos (PostgreSQL en AWS RDS): la app nunca se
# conecta directo a la BD ni guarda credenciales de ella.
# En un dispositivo físico con Expo Go usa la IP LAN de tu equipo, no "localhost":
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

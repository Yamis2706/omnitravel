PORT=3000

# PostgreSQL en AWS RDS (los caracteres especiales de la contraseña deben ir codificados, ej. ? -> %3F, + -> %2B)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.rds.amazonaws.com:5432/omnitravel_db
DB_SSL=true
# Recomendado: certificado de la CA de AWS RDS (global-bundle.pem) en una línea con \n,
# para verificar la identidad del servidor. Sin él la conexión va cifrada pero sin verificar.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

VALHALLA_URL=http://localhost:8002

# Secreto para firmar los tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto
# En producción (NODE_ENV=production) el backend no arranca con un secreto de menos de 32 caracteres.

# Carpeta donde se guardan las fotos de evidencia (temporal hasta usar S3)
EVIDENCIAS_DIR=uploads/evidencia

# Orígenes web permitidos (coma separada). Sin definir: Expo web en localhost:8081 y :19006.
# CORS_ORIGINS=http://localhost:8081

# Telemetría @nestjs/observe: desactivada salvo que se definan ambas.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
